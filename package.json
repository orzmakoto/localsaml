{
  "name": "localsaml",
  "version": "0.1.0",
  "description": "A throwaway SAML IdP for local development. Define users in YAML, open a logged-in browser with one command.",
  "type": "module",
  "license": "MIT",
  "bin": { "localsaml": "dist/index.js" },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
    "dev": "node --experimental-strip-types src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["saml", "sso", "idp", "local-development", "mock-idp", "single-sign-on"],
  "dependencies": {
    "@inquirer/prompts": "^7.2.0",
    "@xmldom/xmldom": "^0.9.6",
    "commander": "^12.1.0",
    "node-forge": "^1.3.1",
    "xml-crypto": "^6.0.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-forge": "^1.3.11",
    "typescript": "^5.7.2"
  }
}
